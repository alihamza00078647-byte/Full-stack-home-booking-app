<form action="/search" method="post" class="flex items-center gap-2 mt-7 mb-5 justify-center w-full px-4">
  <div class="relative flex items-center w-full max-w-2xl">
    <input 
      type="text" 
      name="location" 
      placeholder="Where to go?" 
      class="w-full px-6 py-4 bg-gray-50 border border-gray-200 rounded-full 
             focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#ff385c] 
             focus:border-transparent shadow-md transition-all duration-300
             placeholder:text-gray-400 text-gray-700"
    >
    <button 
      type="submit" 
      class="absolute right-2 p-3 rounded-full transition duration-200 
             hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 
             focus:ring-offset-2 focus:ring-[#ff385c] shadow-lg cursor-pointer"
      style="background-color: #ff385c;"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </div>
</form>