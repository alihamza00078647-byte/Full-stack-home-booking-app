<%- include('../partials/head') %>
<style>
    .payment-card { box-shadow: 0 6px 16px rgba(0,0,0,0.12); }
</style>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/navigation') %>
    <form action="/confirm/payments" method="post">
    
    <div class="container mx-auto px-4 md:px-20 py-10">
        <div class="flex items-center gap-4 mb-8">
            <a href="#" class="p-2 hover:bg-gray-200 rounded-full transition">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <h1 class="text-3xl font-semibold text-gray-800">Confirm and pay</h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            
            <div class="order-2 lg:order-1">
                <section class="border-b pb-8 mb-8">
                    <h2 class="text-2xl font-medium mb-6">Your trip</h2>
                    <div class="flex justify-between mb-4">
                        <div>
                            <p class="font-semibold text-gray-800">Dates</p>
                            <p class="text-gray-600">Apr 15 – 20, 2026</p>
                        </div>
                        <button class="font-semibold underline decoration-solid hover:text-black">Edit</button>
                    </div>
                    <div class="flex justify-between">
                        <div>
                            <p class="font-semibold text-gray-800">Guests</p>
                            <p class="text-gray-600">2 guests</p>
                        </div>
                        <button class="font-semibold underline decoration-solid hover:text-black">Edit</button>
                    </div>
                </section>
                

                <section class="mb-8">
                    <h2 class="text-2xl font-medium mb-6">Pay with</h2>
                    <div class="border rounded-lg p-4 bg-white flex justify-between items-center cursor-pointer hover:border-black transition">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-credit-card text-xl"></i>
                            <span class="text-gray-700">Credit or debit card</span>
                        </div>
                        <div class="flex gap-1">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" class="h-4" alt="Visa">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" class="h-4" alt="Mastercard">
                        </div>
                    </div>
                    
                    <div class="mt-6 space-y-4">
                        <input type="text" name="cardNumber" placeholder="Card number" class="w-full p-4 border rounded-t-lg focus:outline-none focus:ring-2 focus:ring-black">
                        <div class="flex gap-0">
                            <input type="text" name="expiration" placeholder="Expiration" class="w-1/2 p-4 border border-t-0 rounded-bl-lg focus:outline-none focus:ring-2 focus:ring-black">
                            <input type="text" name="cvv" placeholder="CVV" class="w-1/2 p-4 border border-t-0 border-l-0 rounded-br-lg focus:outline-none focus:ring-2 focus:ring-black">
                        </div>
                    </div>
                </section>

                    <input type="text" name="id" value="<%= home._id %>" >

                    <button type="submit" class="w-full md:w-auto px-10 py-4 cursor-pointer bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-lg text-lg transition shadow-lg active:scale-95">
                        Confirm and pay
                    </button>

                </div>

            <div class="order-1 lg:order-2">
                <div class="payment-card sticky top-28 bg-white border border-gray-200 rounded-2xl p-6">
                    <div class="flex gap-4 pb-6 border-b mb-6">
                        <img src="<%= home.photoUrl %>" class="h-28 w-28 object-cover rounded-xl" alt="Listing Image">
                        <div class="flex flex-col justify-between">
                            <p class="text-xs text-gray-500 uppercase font-bold tracking-widest">Modern Apartment</p>
                            <p class="text-gray-800 text-sm">Luxury Stay in the heart of Lahore</p>
                            <p class="text-sm font-semibold flex items-center gap-1">
                                <i class="fa-solid fa-star text-xs"></i> <%= home.rating %> <span class="text-gray-400 font-normal">(124 reviews)</span>
                            </p>
                        </div>
                    </div>

                    <h2 class="text-xl font-medium mb-4">Price details</h2>
                    <div class="space-y-3 text-gray-600">
                        <div class="flex justify-between">
                            <p>$ <%= home.price %> x 5 nights</p>
                            <p>$ <%= home.price * 5 %></p>
                        </div>
                        <div class="flex justify-between underline decoration-solid">
                            <p>Service fee</p>
                            <p>$85</p>
                        </div>
                        <div class="flex justify-between underline decoration-solid">
                            <p>Taxes</p>
                            <p>$42</p>
                        </div>
                    </div>

                    <div class="border-t mt-6 pt-6 flex justify-between font-bold text-gray-800 text-lg">
                        <p>Total (USD)</p>
                        <p>$ <%= home.price * 5 + 85 + 42 %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

</body>
</html>