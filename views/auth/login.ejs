<%- include('../partials/head') %>

<link rel="stylesheet" href="/css/output.css">

<style>
  body { font-family: 'Plus Jakarta Sans', sans-serif; }

  .input-group:focus-within {
    border-color: #000;
    box-shadow: 0 0 0 2px #000;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .card { animation: fadeUp 0.35s ease both; }
</style>
</head>

<body class="bg-gray-100 min-h-screen">

  <%- include('../partials/navigation') %>


  <!-- ── Centered Card ─────────────────────────────────────── -->
  <div class="min-h-[calc(100vh-64px)] flex items-center justify-center p-4">

    <div class="card bg-white w-full max-w-[568px] rounded-2xl shadow-2xl overflow-hidden">

      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <button
          onclick="history.back()"
          class="p-2 rounded-full hover:bg-gray-100 transition-colors"
          aria-label="Close"
        >
          <svg viewBox="0 0 32 32" class="h-4 w-4 fill-none stroke-current stroke-[3px]">
            <path d="m6 6 20 20M26 6 6 26"/>
          </svg>
        </button>
        <h1 class="font-semibold text-base">Log in or sign up</h1>
        <div class="w-8"></div>
      </div>

      <!-- Body -->
      <div class="p-8">
        
        <!-- ── Error Messages Section ── -->
        <%- include('../partials/loginerror') %>

        <h2 class="text-[22px] font-bold text-gray-900 mb-7">Welcome to airbnb</h2>

        <form action="/login" method="POST" class="space-y-4">
          <!-- Stacked Input -->
          <div class="input-group border border-gray-300 rounded-xl overflow-hidden transition-all duration-150">
            <div class="px-4 pt-3 pb-2 border-b border-gray-300">
              <label for="email" class="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-0.5">Email</label>
              <input
                id="email" type="email" name="email"
                placeholder="Email address"
                class="w-full text-sm text-gray-900 bg-transparent placeholder-gray-400 focus:outline-none py-0.5"
                value="<%= locals.oldInput ? oldInput.email : '' %>"
                required
              />
            </div>
            <div class="px-4 pt-3 pb-3">
              <label for="password" class="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-0.5">Password</label>
              <input
                id="password" type="password" name="password"
                placeholder="Password"
                class="w-full text-sm text-gray-900 bg-transparent placeholder-gray-400 focus:outline-none py-0.5"
                required
              />
            </div>
          </div>

          <p class="text-xs text-gray-500 leading-relaxed">
            We'll call or text you to confirm your number. Standard message and data rates apply.
            <a href="#" class="underline font-semibold text-gray-700 hover:text-black transition-colors">Privacy Policy</a>
          </p>

          <button
            type="submit"
            class="w-full bg-gradient-to-r from-[#FF385C] to-[#E31C5F] hover:from-[#E31C5F] hover:to-[#C31162] text-white font-semibold py-3.5 rounded-xl transition-all duration-200 text-base shadow-lg shadow-pink-200 hover:shadow-pink-300 active:scale-[0.98]"
          >
            Log in
          </button>
        </form>

        <!-- Divider and Social Buttons omitted for brevity, but they stay exactly as you had them -->
        
        <div class="relative my-6 flex items-center">
          <div class="flex-1 border-t border-gray-200"></div>
          <span class="mx-4 text-xs font-medium text-gray-400 uppercase tracking-widest">or</span>
          <div class="flex-1 border-t border-gray-200"></div>
        </div>

        <div class="space-y-3">
          <!-- Facebook Button -->
          <button class="w-full relative flex items-center border border-gray-800 px-5 py-3.5 rounded-xl hover:bg-gray-50 active:bg-gray-100 transition-colors font-semibold text-sm text-gray-900">
             <svg viewBox="0 0 32 32" class="h-5 w-5 absolute left-5 fill-[#1877F2]">
              <path d="M30 16a14 14 0 1 0-16.18 13.83v-9.78h-3.55V16h3.55v-2.66c0-3.5 2.08-5.44 5.28-5.44 1.54 0 3.15.28 3.15.28v3.46h-1.77c-1.74 0-2.28 1.08-2.28 2.18V16h3.91l-.63 4.05h-3.28v9.78A14 14 0 0 0 30 16z"/>
            </svg>
            <span class="flex-1 text-center">Continue with Facebook</span>
          </button>
          <!-- Google Button -->
          <button class="w-full relative flex items-center border border-gray-800 px-5 py-3.5 rounded-xl hover:bg-gray-50 active:bg-gray-100 transition-colors font-semibold text-sm text-gray-900">
             <svg viewBox="0 0 32 32" class="h-5 w-5 absolute left-5">
              <path d="M30.01 16.48c0-.84-.07-1.64-.21-2.42H16.24v4.58h7.72c-.33 1.79-1.34 3.3-2.85 4.32v3.59h4.62c2.7-2.48 4.28-6.14 4.28-10.07z" fill="#4285F4"/>
              <path d="M16.24 30.5c3.92 0 7.21-1.3 9.62-3.51l-4.62-3.59c-1.28.86-2.92 1.36-4.99 1.36-3.83 0-7.07-2.58-8.23-6.05H3.3v3.71c2.39 4.75 7.3 8.08 12.94 8.08z" fill="#34A853"/>
              <path d="M8.01 18.71c-.29-.86-.46-1.79-.46-2.75s.17-1.89.46-2.75V9.5H3.3c-.99 1.97-1.55 4.19-1.55 6.46s.56 4.49 1.55 6.46l4.71-3.71z" fill="#FBBC05"/>
              <path d="M16.24 6.75c2.13 0 4.05.73 5.55 2.17l4.16-4.16C23.44 2.45 20.15 1.15 16.24 1.15 10.6 1.15 5.69 4.48 3.3 9.23l4.71 3.71c1.16-3.47 4.4-6.05 8.23-6.05z" fill="#EA4335"/>
            </svg>
            <span class="flex-1 text-center">Continue with Google</span>
          </button>
        </div>

        <p class="text-center text-sm text-gray-500 mt-6">
          Don't have an account?
          <a href="/signup" class="font-semibold text-gray-900 underline hover:text-[#FF385C] transition-colors">Sign up</a>
        </p>
      </div>
    </div>

  </div>
</body>
</html>