            </div>
            <span class="text-[#FF385C] font-bold text-xl tracking-tighter">azeem host</span>
        </div>
        <div class="flex items-center gap-4">
            <a href="/host/addhome" class="text-sm font-semibold border border-gray-300 px-6 py-2.5 rounded-full hover:shadow-md hover:bg-gray-50 transition-all">Create new listing</a>
            <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center text-white text-sm font-bold shadow-inner">A</div>
        </div>
    </header>
    
    <main class="max-w-5xl mx-auto py-12 px-6">
        <div class="flex items-center justify-between mb-10">
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Your Hosted Collections</h1>
            <span class="text-gray-500 text-sm font-medium"><%= hostHomes.length %> listings</span>
        </div>

        <div class="space-y-8">
            <% hostHomes.forEach(home => { %>
                <div class="bg-white rounded-3xl shadow-sm border border-gray-200 overflow-hidden flex flex-col md:flex-row transition-all hover:shadow-2xl hover:-translate-y-1 group">
                    
                    <div class="w-full md:w-[380px] h-72 md:h-auto relative overflow-hidden">
                        <img src="<%=home.mainImage%>" 
                             alt="<%=home.houseName%>" 
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-widest shadow-sm text-gray-800 border border-gray-100">
                            Luxury Suite
                        </div>
                    </div>
                    
                    <div class="flex-1 p-8 flex flex-col justify-between bg-white">
                        <div>
                            <div class="flex justify-between items-start">
                                <div class="space-y-1">
                                    <p class="text-[11px] text-[#FF385C] font-bold uppercase tracking-[0.2em]">Entire Home in <%= home.location %></p>
                                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight tracking-tight"><%= home.houseName %></h2>
                                </div>
                                <div class="flex items-center gap-1.5 bg-gray-900 text-white px-3 py-1 rounded-full shadow-lg">
                                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 fill-white"><path d="M15.094 1.579l-4.124 8.885-9.86 1.27a1 1 0 0 0-.551 1.748l7.233 6.812-1.834 9.77a1 1 0 0 0 1.473 1.073l8.57-4.737 8.57 4.737a1 1 0 0 0 1.473-1.073l-1.834-9.77 7.233-6.812a1 1 0 0 0-.551-1.748l-9.86-1.27-4.124-8.885a1 1 0 0 0-1.812 0z"></path></svg>
                                    <span class="text-xs font-bold"><%= home.rating %></span>
                                </div>
                            </div>
                            
                            <p class="mt-5 text-gray-500 text-[15px] leading-relaxed line-clamp-2 font-light">
                                <%= home.description %>
                            </p>
                            
                            <div class="mt-6 flex items-center gap-2 text-gray-400">
                                <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-none stroke-current stroke-[2px]"><path d="M16 31s12-12.033 12-20c0-6.627-5.373-12-12-12S4 4.373 4 11c0 7.967 12 20 12 20z"></path><circle cx="16" cy="11" r="4"></circle></svg>
                                <span class="text-sm font-medium tracking-wide"><%= home.location %>, Pakistan</span>
                            </div>
                        </div>
                        
                        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="text-xs text-gray-400 uppercase font-bold tracking-widest">Starting from</span>
                                <div class="flex items-baseline gap-1">
                                    <span class="text-2xl font-black text-gray-900">PKR <%= home.price %></span>
                                    <span class="text-gray-400 text-sm">/ night</span>
                                </div>
                            </div>
                            
                            <div class="flex gap-3">
                                <a href="/host/hosthomepage/edit/<%=home._id%>?editing=true" class="px-6 py-2.5 text-sm font-bold border-2 border-gray-900 rounded-xl hover:bg-gray-900 hover:text-white transition-all duration-300">Edit</a>
                                <a href="/host/hosthomepage/remove/<%=home._id%>" class="px-6 py-2.5 text-sm font-bold bg-[#FF385C] text-white rounded-xl hover:bg-[#E31C5F] hover:shadow-xl transition-all duration-300">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <footer class="py-12 text-center text-gray-400 text-xs uppercase tracking-[0.3em]">
        &copy; 2026 Airbnb &bull; All Rights Reserved
    </footer>
</body>
</html>